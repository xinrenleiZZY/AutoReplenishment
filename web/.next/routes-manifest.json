{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [
      {
        "source": "/api/:path*",
        "destination": "http://127.0.0.1:8001/api/:path*",
        "regex": "^/api(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
      }
    ],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/calculation/[asin]",
      "regex": "^/calculation/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPasin": "nxtPasin"
      },
      "namedRegex": "^/calculation/(?<nxtPasin>[^/]+?)(?:/)?$"
    },
    {
      "page": "/products/[asin]",
      "regex": "^/products/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPasin": "nxtPasin"
      },
      "namedRegex": "^/products/(?<nxtPasin>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/calculation",
      "regex": "^/calculation(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/calculation(?:/)?$"
    },
    {
      "page": "/category-leadtimes",
      "regex": "^/category\\-leadtimes(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/category\\-leadtimes(?:/)?$"
    },
    {
      "page": "/daily-report",
      "regex": "^/daily\\-report(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/daily\\-report(?:/)?$"
    },
    {
      "page": "/dashboard",
      "regex": "^/dashboard(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard(?:/)?$"
    },
    {
      "page": "/festival-calendar",
      "regex": "^/festival\\-calendar(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/festival\\-calendar(?:/)?$"
    },
    {
      "page": "/inventory",
      "regex": "^/inventory(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/inventory(?:/)?$"
    },
    {
      "page": "/lifecycle",
      "regex": "^/lifecycle(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/lifecycle(?:/)?$"
    },
    {
      "page": "/products",
      "regex": "^/products(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/products(?:/)?$"
    },
    {
      "page": "/seasonal-curves",
      "regex": "^/seasonal\\-curves(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/seasonal\\-curves(?:/)?$"
    },
    {
      "page": "/settings",
      "regex": "^/settings(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/settings(?:/)?$"
    },
    {
      "page": "/sync-logs",
      "regex": "^/sync\\-logs(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/sync\\-logs(?:/)?$"
    },
    {
      "page": "/time-axis",
      "regex": "^/time\\-axis(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/time\\-axis(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}