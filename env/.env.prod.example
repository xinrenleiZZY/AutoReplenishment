# 生产环境模板（Phase 1 / G-09）——只列"与其它环境不同/必须显式确认"的项，
# 其余项与仓库根 .env 一致（真实值不入库，从密钥管理/部署环境注入）。

APP_ENV=production
APP_DEBUG=false
LOG_LEVEL=INFO

# 生产库
DATABASE_URL=postgresql+asyncpg://postgres:postgres@host.docker.internal:5433/auto_replenishment

# 生产 CORS 白名单（禁止 *）
CORS_ORIGINS=http://localhost:9100,http://127.0.0.1:9100

# Phase 0 / G-04：写操作鉴权 token（64 位随机串；与 web 容器同值）
API_AUTH_TOKEN=__SET_PROD_TOKEN__

# 外部超时（待办-12：600 → 90，避免故障时卡 6 分钟）
LX_STATION_TIMEOUT=90

# 生产必须开启
AI_AUTO_EVALUATE=true
