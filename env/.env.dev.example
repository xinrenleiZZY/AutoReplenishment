# 开发环境模板（Phase 1 / G-09 环境分层）
# 用法：Copy-Item env/.env.dev.example .env  （或在 PowerShell 里 $env:ENV_FILE="env/.env.dev"; docker compose up -d）
#
# 与 prod 的差异：放开 CORS、开 SQL echo、缩短同步窗口、关闭真实外发（飞书/日报）

APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=DEBUG

# 本地库（不要指向生产库）
DATABASE_URL=postgresql+asyncpg://postgres:postgres@host.docker.internal:5433/auto_replenishment_dev

# 开发期允许任意来源，方便前端本地调试
CORS_ORIGINS=*

# 开发环境不启用写操作鉴权（留空）
API_AUTH_TOKEN=

# 外部超时调短，快速失败
LX_STATION_TIMEOUT=60

# 关闭真实外发
AI_AUTO_EVALUATE=false
DAILY_REPORT_TIME=23:59
FEISHU_WEBHOOK_URL=
