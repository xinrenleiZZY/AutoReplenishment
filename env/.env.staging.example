# 预发/验证环境模板（Phase 1 / G-09）
# 用法：Copy-Item env/.env.staging.example .env 或 $env:ENV_FILE="env/.env.staging"; docker compose up -d
#
# 要求：与 prod 同一镜像；数据库使用**脱敏副本**（从备份恢复后打乱客户/联系方式等敏感列）；
# 外部通道（飞书/领星/DeepSeek）用测试凭据或关闭，避免误发/误写生产系统。

APP_ENV=staging
APP_DEBUG=false
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://postgres:postgres@host.docker.internal:5433/auto_replenishment_staging

CORS_ORIGINS=http://localhost:9100,http://127.0.0.1:9100

# 预发环境启用鉴权，验证与生产一致的调用链（token 与 web 容器共用同一个 .env）
API_AUTH_TOKEN=__SET_STAGING_TOKEN__

LX_STATION_TIMEOUT=90

# 预发默认关闭真实推送与 AI 评估
AI_AUTO_EVALUATE=false
FEISHU_WEBHOOK_URL=
