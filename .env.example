# 数据库配置
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/auto_replenishment

# 领星API配置
LX_API_BASE_URL=https://api.lingxing.com
LX_APP_KEY=your_app_key
LX_APP_SECRET=your_app_secret
LX_COMPANY_ID=your_company_id

# 领星 API 服务站（首选通道：登录态由服务端注入，摆脱本地 auth-token 顶号问题）
LX_STATION_BASE_URL=http://192.168.40.194:7788
LX_STATION_USER_ID=your_station_user
LX_STATION_PASSWORD=your_station_password
LX_STATION_TIMEOUT=600

# 本地直连兜底（服务站不可用时启用：直接用 auth-token + x-ak-* 头请求领星网页 API）
# LX_AUTH_TOKEN 可留空：鉴权失败时自动接入本机 CDP 浏览器刷新登录态（需下面 4 项）
# 注意：服务站 /api/auth/login 下发的 token 与浏览器会话绑定，不能用于本地 raw 直连
LX_AUTH_TOKEN=
LX_HEADER_COMPANY_ID=your_company_id
LX_HEADER_UID=your_uid
LX_HEADER_ENV_KEY=huizhixin
# 本机 CDP 刷新（需常驻浏览器: python -m browser_api.browser_starter --port 18800）
LX_USERNAME=your_lingxing_username
LX_PASSWORD=your_lingxing_password
LX_CDP_HOST=host.docker.internal
LX_CDP_PORT=18800

# 飞书通知配置（应用机器人方式优先，发送富文本日报）
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=your_app_secret
FEISHU_CHAT_ID=oc_xxxxxxxxxxxxxxxxxxxx
# 自定义机器人 Webhook（备用）
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/your_webhook

# 应用配置
APP_ENV=development
APP_DEBUG=true
SYNC_INTERVAL_HOURS=24
SYNC_TIME=01:00
CALC_INTERVAL_HOURS=24
DAILY_REPORT_TIME=09:00
LOG_LEVEL=INFO

# 按等级计算频率（天），可自定义，格式: S:1,A:3,B:5,C:7,D:14
CALC_FREQUENCIES=S:1,A:3,B:5,C:7,D:14
CALC_FREQUENCY_DEFAULT=14
